{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "mauritius-dataset-reservoirs-trigger",
  "main": "index.js",
  "compatibility_date": "2026-11-01",
  // No web address: it only runs on its schedule.
  "workers_dev": false,
  "preview_urls": false,
  // 07:00 and 15:00 UTC, as the workflow's own schedule.
  "triggers": { "crons": ["0 7,15 * * *"] },
  "observability": { "enabled": true }
}
